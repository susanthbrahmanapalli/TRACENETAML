# TraceNet - Environment Configuration
APP_NAME=TraceNet
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./tracenet.db

# Currency and Localization
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
COUNTRY_CODE=IN

# Risk Engine Configuration
DEFAULT_RISK_THRESHOLD=55.0
HIGH_RISK_THRESHOLD=75.0
CRITICAL_RISK_THRESHOLD=90.0
RULES_VERSION=1.0.0

# Graph Analytics Limits
MAX_GRAPH_HOP_DEPTH=3
MAX_NEIGHBORHOOD_NODES=100
MAX_CYCLE_LENGTH=5
